# Copy to .env, or just run `npm run setup` to generate one.

# The only password. Protects the web board and the API.
# Use something long and random. The app refuses to start without it.
APP_PASSWORD=change-me-to-something-long-and-random

# Where the SQLite file lives. In Docker this is /data/pandan.db.
DB_PATH=./data/pandan.db

# Port the server listens on.
PORT=3000
